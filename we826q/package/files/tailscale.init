#!/bin/sh /etc/rc.common
# EXPERIMENTAL NOT FLASHED. No START/STOP: deliberately no boot S symlink.
USE_PROCD=1
start_service() {
    config_load we826q-tailscale
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    mkdir -p /etc/tailscale /var/run/tailscale
    chmod 700 /etc/tailscale
    procd_open_instance
    procd_set_param command /usr/sbin/tailscaled --state=/etc/tailscale/tailscaled.state --socket=/var/run/tailscale/tailscaled.sock --port=41641
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
